#!/bin/zsh -f
# Shell trampoline, ~6ms from pane spawn to here. It exists to pin how the
# interpreter starts: -S skips site/sitecustomize processing (the palette is
# pure stdlib) and -E ignores PYTHON* env, which together cut a chunk off the
# ~115ms interpreter start that dominates time-to-first-paint.

# Plugin panes inherit the Herdr server's environment. Started as a service
# (launchd, systemd) that is a bare /usr/bin:/bin:/usr/sbin:/sbin, and -f skips
# the rc files that would otherwise repair it, so neither fzf nor herdr itself
# is reachable and the popup dies before it can paint. Builtins only, so the
# healthy path pays nothing.
_pre=
for _d in /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /usr/local/sbin \
          /home/linuxbrew/.linuxbrew/bin $HOME/.nix-profile/bin $HOME/.local/bin; do
  [[ -d $_d ]] && _pre=$_pre$_d:
done
export PATH=$_pre$PATH
unset _pre _d

# Anything the list above cannot guess — nix, asdf, a custom prefix — is worth
# a login shell, but only once the free lookup has already missed.
if ! whence -p fzf >/dev/null 2>&1; then
  _p=${SHELL:-/bin/sh}
  _p=$($_p -lc 'printf %s "$PATH"' 2>/dev/null)
  [[ -n $_p ]] && export PATH=$_p
  unset _p
fi

if [[ -n $HERDR_PALETTE_TRACE ]]; then
  zmodload zsh/datetime
  export HERDR_PALETTE_T0=$EPOCHREALTIME
  print -r -- "$EPOCHREALTIME  trampoline exec" >> $HERDR_PALETTE_TRACE
fi
exec python3 -S -E "${0:A:h}/palette.py" "$@"
